# Maia Store — Environment Variables
# Copy this file to .env.local and fill in the values

# Database (SQLite — currently using local file, not required for Vercel)
# DATABASE_URL="file:./db/custom.db"

# WhatsApp Business number (used in contact/checkout)
NEXT_PUBLIC_WHATSAPP_NUMBER=51907674693

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_READ_TOKEN=""
SANITY_API_READ_TOKEN=""
NEXT_PUBLIC_COMPANY_NAME="Maia Store"

# Optional: Analytics
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_FB_PIXEL_ID="XXXXXXXXXXXXXXX"

# Optional: Site URL for SEO (auto-set by Vercel)
# NEXT_PUBLIC_SITE_URL="https://maia-store.vercel.app"